NODE_ENV=production
PORT=3000

# Opção A — usada no Render/Neon (uma única connection string):
# pegue no painel do Neon (Dashboard > Connection Details > "Pooled connection")
DATABASE_URL=postgresql://usuario:senha@ep-xxxx.neon.tech/arcomix_pdv?sslmode=require

# Opção B — desenvolvimento local (Postgres na sua máquina), usada só se
# DATABASE_URL não estiver definida:
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=arcomix_pdv

# true cria as tabelas automaticamente (bom pra rodar de graça sem se
# preocupar com migration); em produção "de verdade" isso deveria ser false.
DB_SYNCHRONIZE=true

JWT_SECRET=troque-por-um-segredo-forte-em-producao
JWT_EXPIRES_IN=8h
